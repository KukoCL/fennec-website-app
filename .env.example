# PUBLIC endpoint URLs, including the API Gateway stage if present. No custom domain required.
# One existing website BFF handles Auth and both telemetry environments server-side.
# HTTP allowed only for local development (same host as the frontend, no mixed-content HTTPS).
VITE_DASHBOARD_API_BASE_URL=

# OPTIONAL public browser API key. Restrict to Maps Embed API + approved website referrers.
# Never use a server key here. Missing key keeps the no-network local map.
VITE_GOOGLE_MAPS_EMBED_API_KEY=

# Never place Auth API keys, JWTs, Quest admin keys or AWS credentials in VITE_* variables.
